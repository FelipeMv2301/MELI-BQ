#Django config
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
#Vacío en dev; en prod: https://<host-real>
CSRF_TRUSTED_ORIGINS=

#Version: SQLITE (dev) o cualquier otro valor (Postgres)
DATABASE_VERSION=SQLITE
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

#Mercado Libre — SPK-MELI-1 pendiente (crear app en developers.mercadolibre.cl)
ML_APP_ID=
ML_APP_SECRET=
ML_REDIRECT_URI=
ML_SITE_ID=MLC

#Login — Google OAuth (django-allauth), portado de gestorBQ. El redirect URI a registrar en
#Google Cloud Console es http://127.0.0.1:8000/accounts/google/login/callback/ (dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DOMINIO_PERMITIDO=@bioquimica.cl

#WooCommerce — solo lectura (fotos + descripción por SKU)
WOO_URL=
WOO_KEY=
WOO_SECRET=

#Stock-Service — solo lectura (catálogo/stock/precio SAP). API REST (SPK-MELI-5, resuelto).
STOCKSERVICE_BASE_URL=
STOCKSERVICE_API_KEY=

#Conexión a Token-SAP-BQ (sesión SAP compartida)
TOKEN_SAP_BQ_URL=
TOKEN_SAP_BQ_SERVICE_NAME=
TOKEN_SAP_BQ_PASSWORD=
SAP_URL=

#Facele/Docele — obtención de PDF de boleta/factura ya emitida
FACELE_URL=
FACELE_USER=
FACELE_PASSWORD=
FACELE_TAXID=
